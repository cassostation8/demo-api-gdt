# Demo config — copy to .env. All values are optional; no Casso keys go here (visitors enter their own x-client-id / x-secret-key on the UI).

# Port the demo server listens on (pick one not used by other apps on the server, e.g. demo-api-transaction uses 3030)
PORT=3040

# Casso Console API host (same for sandbox and production; they differ only by credential)
CASSO_BASE_URL=https://api-console.casso.vn

# Upstream timeout in ms when calling Casso Console
CASSO_TIMEOUT_MS=45000

# Optional per-environment overrides of CASSO_BASE_URL
# CASSO_SANDBOX_BASE_URL=
# CASSO_PRODUCTION_BASE_URL=

# Public URL of this demo INCLUDING any sub-path, e.g. https://<host>/demo-api-gdt
# Used for the Redirect/Webhook URLs shown on the UI. Leave empty to let the browser derive it from the page URL.
PUBLIC_BASE_URL=

# Number of reverse proxies in front of the server (nginx/ngrok) trusted for X-Forwarded-*
TRUST_PROXY_HOPS=1

# Max /api, /casso/callback and /casso/webhook requests per IP per minute (generous: many people at one office or event share an IP)
RATE_LIMIT_PER_MIN=300

# Link for the "Mã nguồn" button
GITHUB_URL=https://github.com

# ngrok reserved domain for `npm run tunnel` (local dev only)
NGROK_DOMAIN=
